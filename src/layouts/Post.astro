---
// Shared page for a single article or note.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata, MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Tags from '../components/Tags.astro';
import ProseEnhancements from '../components/ProseEnhancements.astro';
import { isoDate, type Item, type Project } from '../lib/content';

interface Props {
  kind: 'article' | 'note';
  title: string;
  description?: string;
  date: Date;
  updated?: Date;
  tags: string[];
  project?: Project;
  cover?: ImageMetadata;
  coverAlt?: string;
  minutes?: number;
  headings?: MarkdownHeading[];
  newer?: Item;
  older?: Item;
}

const {
  kind,
  title,
  description,
  date,
  updated,
  tags,
  project,
  cover,
  coverAlt = '',
  minutes,
  headings = [],
  newer,
  older,
} = Astro.props;

const section = kind === 'article' ? { label: 'Articles', href: '/articles/' } : { label: 'Notes', href: '/notes/' };
const contents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const showContents = contents.length >= 3;
const shareImage = cover ? (await getImage({ src: cover, width: 1200, format: 'jpg' })).src : undefined;
---

<Base title={title} description={description} image={shareImage} published={date}>
  <article class="wrap post">
    <header class="head">
      <p class="crumb mono">
        <a href={section.href}>&larr; All {section.label.toLowerCase()}</a>
      </p>
      <h1 class:list={{ small: kind === 'note' }}>{title}</h1>
      {/* A note's description is only an excerpt for link previews, so it isn't repeated here. */}
      {kind === 'article' && description && <p class="lede">{description}</p>}

      <dl class="facts mono">
        <div>
          <dt>Published</dt>
          <dd><time datetime={isoDate(date)}>{isoDate(date)}</time></dd>
        </div>
        {
          updated && (
            <div>
              <dt>Updated</dt>
              <dd>
                <time datetime={isoDate(updated)}>{isoDate(updated)}</time>
              </dd>
            </div>
          )
        }
        {
          minutes && (
            <div>
              <dt>Reading time</dt>
              <dd>{minutes} min</dd>
            </div>
          )
        }
        {
          project && (
            <div>
              <dt>Project</dt>
              <dd>
                <a class="link" href={`/projects/${project.id}/`}>
                  {project.data.title}
                </a>
              </dd>
            </div>
          )
        }
        {
          tags.length > 0 && (
            <div>
              <dt>Tags</dt>
              <dd>
                <Tags tags={tags} />
              </dd>
            </div>
          )
        }
      </dl>
    </header>

    {
      cover && (
        <Image
          class="cover"
          src={cover}
          alt={coverAlt}
          widths={[640, 960, 1280, 1920]}
          sizes="(min-width: 73rem) 68rem, 94vw"
          loading="eager"
          fetchpriority="high"
        />
      )
    }

    <div class="columns">
      <div class="prose">
        <slot />
      </div>

      {
        showContents && (
          <aside class="rail">
            <nav class="contents mono" aria-label="On this page">
              <p class="rail-label">On this page</p>
              <ol>
                {contents.map((heading) => (
                  <li data-depth={heading.depth}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )
      }
    </div>

    {
      (newer || older) && (
        <nav class="adjacent" aria-label={`More ${section.label.toLowerCase()}`}>
          {older ? (
            <a href={older.href}>
              <span class="mono">&larr; Older</span>
              <span class="title">{older.title}</span>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a class="next" href={newer.href}>
              <span class="mono">Newer &rarr;</span>
              <span class="title">{newer.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>

  <ProseEnhancements />
</Base>

<script>
  // Highlight the section being read in the "On this page" list.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.contents a')].map((link) => [
      decodeURIComponent(link.hash.slice(1)),
      link,
    ]),
  );

  if (links.size > 0) {
    const headings = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((heading): heading is HTMLElement => heading !== null);

    const update = () => {
      const passed = headings.filter((heading) => heading.getBoundingClientRect().top < 120);
      const current = passed.at(-1) ?? headings[0];
      for (const [id, link] of links) link.toggleAttribute('data-current', id === current?.id);
    };

    update();
    document.addEventListener('scroll', update, { passive: true });
  }
</script>

<style>
  .post {
    padding-top: clamp(2.5rem, 7vw, 5rem);
  }

  h1 {
    max-width: 52rem;
    font-size: clamp(2.6rem, 7vw, 4.75rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  h1.small {
    max-width: 44rem;
    font-size: clamp(2.1rem, 5vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.022em;
  }

  .lede {
    margin-top: 1.25rem;
  }

  /* A strip of facts under the title, ruled like the header of a datasheet. */
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem clamp(1.75rem, 5vw, 3.5rem);
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
    padding-block: 0.9rem 1rem;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
  }

  .facts dt {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .facts dd {
    margin: 0.15rem 0 0;
    color: var(--ink);
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: 0.8rem;
  }

  .facts .link {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.25em;
  }

  .facts :global(.tags) {
    font-size: 0.8rem;
  }

  .facts :global(.tags a) {
    color: var(--ink);
  }

  .facts :global(.tags a:hover) {
    color: var(--accent);
  }

  .post :global(.cover) {
    width: 100%;
    max-height: 36rem;
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--sunken);
  }

  .columns {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) minmax(0, 1fr);
    gap: 3rem;
    margin-top: clamp(2.25rem, 5vw, 3.5rem);
  }

  .rail {
    justify-self: end;
    width: 100%;
    max-width: 15rem;
  }

  .contents {
    position: sticky;
    top: 2rem;
  }

  .rail-label {
    padding-top: 0.7rem;
    border-top: 1px solid var(--ink);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink);
  }

  .contents ol {
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 0.78rem;
  }

  .contents li {
    padding-block: 0.28rem;
  }

  .contents li[data-depth='3'] {
    padding-left: 0.9rem;
  }

  .contents a {
    display: block;
    transition: color 0.15s;
  }

  .contents a[data-current] {
    color: var(--accent);
  }

  @media (max-width: 62rem) {
    .columns {
      grid-template-columns: minmax(0, 1fr);
    }

    .rail {
      display: none;
    }
  }

  .adjacent {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: 1.1rem;
    border-top: 1px solid var(--ink);
  }

  .adjacent a {
    display: grid;
    gap: 0.35rem;
    text-decoration: none;
  }

  .adjacent .next {
    grid-column: 2;
    text-align: right;
  }

  .adjacent .title {
    font-size: 1.3rem;
    line-height: 1.2;
    letter-spacing: -0.012em;
  }

  .adjacent a:hover .title {
    color: var(--accent);
  }
</style>
