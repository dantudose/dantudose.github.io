---
// Layout for standalone Markdown pages in src/pages (About, for example).
import Base from './Base.astro';
import ProseEnhancements from '../components/ProseEnhancements.astro';

interface Props {
  frontmatter: { title: string; description?: string };
}

const { title, description } = Astro.props.frontmatter;
---

<Base title={title} description={description}>
  <div class="wrap">
    <header class="page-head">
      <h1>{title}</h1>
    </header>
    <div class="prose section">
      <slot />
    </div>
  </div>
  <ProseEnhancements />
</Base>
