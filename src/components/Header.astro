---
import { SITE } from '../lib/site';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${SITE.name} — home`}>
      Signal <span class="amp">&amp;</span> Noise
    </a>

    <nav class="mono" aria-label="Main">
      {
        SITE.nav.map(({ label, href }) => (
          <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
    </nav>

    <button class="theme" type="button" data-theme-toggle aria-label="Switch between light and dark theme">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
        <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  const root = document.documentElement;
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const current =
      root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Private browsing: the choice just won't be remembered.
    }
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 1.75rem;
    padding-block: 1.1rem;
  }

  .brand {
    margin-right: auto;
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-decoration: none;
    white-space: nowrap;
  }

  .amp {
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
  }

  nav {
    display: flex;
    gap: 1.6rem;
  }

  nav a {
    position: relative;
    padding-block: 0.35rem;
    transition: color 0.15s;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: var(--accent);
  }

  .theme {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-right: -0.5rem;
    padding: 0;
    color: var(--muted);
    background: none;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    transition: color 0.15s;
  }

  .theme:hover {
    color: var(--ink);
  }

  @media (max-width: 44rem) {
    .bar {
      padding-block: 0.9rem 0.7rem;
    }

    nav {
      order: 3;
      width: 100%;
      justify-content: space-between;
      gap: 0.75rem;
      margin-top: 0.5rem;
    }

    nav.mono {
      font-size: 0.7rem;
    }
  }
</style>
