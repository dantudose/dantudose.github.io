---
import { Image } from 'astro:assets';
import Status from './Status.astro';
import type { Project } from '../lib/content';

interface Props {
  project: Project;
  /** Number of articles and notes filed under this project. */
  entries: number;
}

const { project, entries } = Astro.props;
const { title, description, status, cover, coverAlt } = project.data;
---

<article class="card">
  {
    cover && (
      <div class="media">
        <Image src={cover} alt={coverAlt} widths={[400, 640, 960]} sizes="(min-width: 60rem) 26rem, 92vw" />
      </div>
    )
  }
  <div class="head">
    <h3>
      <a href={`/projects/${project.id}/`}>{title}</a>
    </h3>
    <Status status={status} />
  </div>
  <p class="summary">{description}</p>
  <p class="mono">{entries} {entries === 1 ? 'entry' : 'entries'} in the log</p>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: 0.5rem;
  }

  .media {
    margin-bottom: 0.6rem;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--sunken);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0, 0.2, 1);
  }

  .card:hover .media :global(img) {
    transform: scale(1.025);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  h3 {
    font-size: 1.5rem;
    letter-spacing: -0.015em;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:hover h3 a {
    color: var(--accent);
  }

  .summary {
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .mono {
    margin-top: 0.2rem;
  }
</style>
