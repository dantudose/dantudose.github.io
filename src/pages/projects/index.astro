---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, getStream } from '../../lib/content';

const projects = await getProjects();
const stream = await getStream();
const entriesIn = (id: string) => stream.filter((item) => item.project === id).length;
---

<Base title="Projects" description="The things being built, each with its own log of articles and notes.">
  <div class="wrap">
    <header class="page-head">
      <h1>Projects</h1>
      <p class="lede">The things being built, each with its own log of articles and notes.</p>
    </header>

    <section class="section">
      <h2 class="label">{projects.length} {projects.length === 1 ? 'project' : 'projects'}</h2>
      {projects.length === 0 && <p class="empty">No projects yet.</p>}
      <div class="grid">
        {projects.map((project) => <ProjectCard project={project} entries={entriesIn(project.id)} />)}
      </div>
    </section>
  </div>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 3rem 2.5rem;
    padding-top: 1.75rem;
  }
</style>
