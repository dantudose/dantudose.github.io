---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import Status from '../../components/Status.astro';
import ProseEnhancements from '../../components/ProseEnhancements.astro';
import { getProjects, getStream, isoDate, type Project } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, status, started, links, cover, coverAlt } = project.data;
const { Content } = await render(project);
const log = (await getStream()).filter((item) => item.project === project.id);
const shareImage = cover ? (await getImage({ src: cover, width: 1200, format: 'jpg' })).src : undefined;
---

<Base title={title} description={description} image={shareImage}>
  <article class="wrap">
    <header class:list={['head', { 'with-cover': cover }]}>
      <div class="intro">
        <p class="crumb mono">
          <a href="/projects/">&larr; All projects</a>
        </p>
        <h1>{title}</h1>
        <p class="lede">{description}</p>

        <dl class="facts mono">
          <div>
            <dt>Status</dt>
            <dd><Status status={status} /></dd>
          </div>
          {
            started && (
              <div>
                <dt>Started</dt>
                <dd>{isoDate(started).slice(0, 7)}</dd>
              </div>
            )
          }
          <div>
            <dt>Log</dt>
            <dd>{log.length} {log.length === 1 ? 'entry' : 'entries'}</dd>
          </div>
        </dl>

        {
          links.length > 0 && (
            <ul class="links mono">
              {links.map((link) => (
                <li>
                  <a href={link.href} rel="noopener">
                    {link.label} <span aria-hidden="true">&nearr;</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        cover && (
          <Image
            class="cover"
            src={cover}
            alt={coverAlt}
            widths={[480, 720, 960, 1280]}
            sizes="(min-width: 60rem) 30rem, 94vw"
            loading="eager"
            fetchpriority="high"
          />
        )
      }
    </header>

    <div class="prose body">
      <Content />
    </div>

    <section class="section log" aria-labelledby="log">
      <h2 class="label" id="log">Project log</h2>
      <EntryList items={log} empty="Nothing has been written about this project yet." />
    </section>
  </article>
  <ProseEnhancements />
</Base>

<style>
  .head {
    padding-top: clamp(2.5rem, 7vw, 5rem);
  }

  .head.with-cover {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  h1 {
    font-size: clamp(2.6rem, 7vw, 4.75rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .lede {
    margin-top: 1.25rem;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem clamp(1.75rem, 5vw, 3.5rem);
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
    padding-block: 0.9rem 1rem;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
  }

  .facts dt {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .facts dd {
    margin: 0.15rem 0 0;
    color: var(--ink);
    font-size: 0.8rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 0.8rem;
  }

  .links a {
    display: inline-flex;
    gap: 0.5rem;
    padding: 0.5rem 0.85rem;
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    transition: border-color 0.15s, color 0.15s;
  }

  .links a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .links span {
    color: var(--accent);
  }

  .head :global(.cover) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--sunken);
  }

  .body {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .log {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  @media (max-width: 60rem) {
    .head.with-cover {
      grid-template-columns: minmax(0, 1fr);
    }

    .head :global(.cover) {
      aspect-ratio: 4 / 3;
    }
  }
</style>
