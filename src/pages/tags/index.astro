---
import Base from '../../layouts/Base.astro';
import { getStream, tagSlug } from '../../lib/content';

const counts = new Map<string, { tag: string; count: number }>();
for (const item of await getStream()) {
  for (const tag of item.tags) {
    const slug = tagSlug(tag);
    counts.set(slug, { tag, count: (counts.get(slug)?.count ?? 0) + 1 });
  }
}
const tags = [...counts].sort(([a], [b]) => a.localeCompare(b));
---

<Base title="Tags" description="Every tag used across articles and notes.">
  <div class="wrap">
    <header class="page-head">
      <h1>Tags</h1>
    </header>
    <section class="section">
      <h2 class="label">{tags.length} {tags.length === 1 ? 'tag' : 'tags'}</h2>
      {tags.length === 0 && <p class="empty">No tags yet.</p>}
      <ul>
        {
          tags.map(([slug, { tag, count }]) => (
            <li>
              <a href={`/tags/${slug}/`}>
                <span class="hash">#</span>
                {tag}
              </a>
              <span class="mono">{count}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.25rem;
    margin: 0;
    padding: 1.75rem 0 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 1.5rem;
    letter-spacing: -0.015em;
  }

  a {
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }

  .hash {
    color: var(--accent);
  }
</style>
