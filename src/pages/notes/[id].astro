---
import { getEntry, render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { excerpt, getNotes, noteItem, type Note } from '../../lib/content';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((entry, index) => ({
    params: { id: entry.id },
    props: { entry, newer: notes[index - 1], older: notes[index + 1] },
  }));
}

interface Props {
  entry: Note;
  newer?: Note;
  older?: Note;
}

const { entry, newer, older } = Astro.props;
const { Content } = await render(entry);
const project = entry.data.project && (await getEntry(entry.data.project));
---

<Post
  kind="note"
  title={entry.data.title}
  description={excerpt(entry.body ?? '')}
  date={entry.data.date}
  tags={entry.data.tags}
  project={project}
  newer={newer && noteItem(newer)}
  older={older && noteItem(older)}
>
  <Content />
</Post>
