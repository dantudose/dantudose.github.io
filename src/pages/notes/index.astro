---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tags from '../../components/Tags.astro';
import ProseEnhancements from '../../components/ProseEnhancements.astro';
import { getNotes, isoDate } from '../../lib/content';

// Notes are short, so the index shows each one in full.
const notes = await Promise.all(
  (await getNotes()).map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<Base title="Notes" description="Short entries: findings, links and half-formed ideas.">
  <div class="wrap">
    <header class="page-head">
      <h1>Notes</h1>
      <p class="lede">Short entries: findings, links and half-formed ideas.</p>
    </header>

    <section class="section">
      <h2 class="label">{notes.length} {notes.length === 1 ? 'note' : 'notes'}</h2>
      {notes.length === 0 && <p class="empty">No notes yet.</p>}
      <ol class="notes">
        {
          notes.map(({ entry, Content }) => (
            <li class="note">
              <p class="mono">
                <a href={`/notes/${entry.id}/`} title="Permanent link to this note">
                  <time datetime={isoDate(entry.data.date)}>{isoDate(entry.data.date)}</time>
                </a>
              </p>
              <div>
                <h3>
                  <a href={`/notes/${entry.id}/`}>{entry.data.title}</a>
                </h3>
                <div class="prose compact">
                  <Content />
                </div>
                <Tags tags={entry.data.tags} />
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
  <ProseEnhancements />
</Base>

<style>
  .notes {
    container-type: inline-size;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .note {
    display: grid;
    gap: 0.5rem 1.5rem;
    padding-block: 1.75rem 2rem;
    border-bottom: 1px solid var(--rule);
  }

  h3 {
    margin-bottom: 0.7rem;
    font-size: 1.5rem;
    letter-spacing: -0.015em;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent);
  }

  .note :global(.tags) {
    margin-top: 1rem;
  }

  @container (min-width: 34rem) {
    .note {
      grid-template-columns: 7rem 1fr;
    }

    .note > .mono {
      padding-top: 0.45rem;
    }
  }
</style>
