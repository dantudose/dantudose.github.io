---
import Base from '../layouts/Base.astro';
import Waveform from '../components/Waveform.astro';
---

<Base title="Page not found" description="There is nothing at this address.">
  <section class="wrap lost">
    <p class="mono">Error 404</p>
    <h1>Nothing but noise here.</h1>
    <Waveform variant="noise" labels={false} />
    <p class="lede">
      That page doesn&rsquo;t exist, or it has moved. Head back to the <a href="/">home page</a> or browse
      the <a href="/articles/">articles</a>.
    </p>
  </section>
</Base>

<style>
  .lost {
    padding-block: clamp(3rem, 9vw, 6.5rem);
  }

  h1 {
    margin-block: 1rem clamp(2rem, 5vw, 3rem);
    font-size: clamp(2.6rem, 7vw, 4.75rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .lede {
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .lede a {
    color: var(--accent);
  }
</style>
