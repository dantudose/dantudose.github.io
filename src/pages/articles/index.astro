---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { articleItem, getArticles } from '../../lib/content';

const items = (await getArticles()).map(articleItem);
---

<Base title="Articles" description="Long-form write-ups: build logs, deep dives and tutorials.">
  <div class="wrap">
    <header class="page-head">
      <h1>Articles</h1>
      <p class="lede">Long-form write-ups: build logs, deep dives and tutorials.</p>
    </header>
    <section class="section">
      <h2 class="label">{items.length} {items.length === 1 ? 'article' : 'articles'}</h2>
      <EntryList items={items} showKind={false} empty="No articles yet." />
    </section>
  </div>
</Base>
