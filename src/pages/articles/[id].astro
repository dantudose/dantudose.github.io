---
import { getEntry, render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { articleItem, getArticles, readingMinutes, type Article } from '../../lib/content';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((entry, index) => ({
    params: { id: entry.id },
    props: { entry, newer: articles[index - 1], older: articles[index + 1] },
  }));
}

interface Props {
  entry: Article;
  newer?: Article;
  older?: Article;
}

const { entry, newer, older } = Astro.props;
const { Content, headings } = await render(entry);
const project = entry.data.project && (await getEntry(entry.data.project));
---

<Post
  kind="article"
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  updated={entry.data.updated}
  tags={entry.data.tags}
  project={project}
  cover={entry.data.cover}
  coverAlt={entry.data.coverAlt}
  minutes={readingMinutes(entry.body)}
  headings={headings}
  newer={newer && articleItem(newer)}
  older={older && articleItem(older)}
>
  <Content />
</Post>
